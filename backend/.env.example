# Server Environment
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cktracker?schema=public"

# Authentication & Security
JWT_SECRET=supersecretmodularfurniturejwtkey2026_cktracker_production_ready
JWT_EXPIRES_IN=7d

# Cloud Storage (Cloudinary - Optional in Dev, fallback to local uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Dispatch (Nodemailer / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="CKTracker Modular Kitchens <notifications@cktracker.com>"

# WhatsApp Business API (Optional / Modular webhook integration)
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_access_token

# Client Application URL
FRONTEND_URL=http://localhost:5173
